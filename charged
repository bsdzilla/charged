#! /usr/bin/env perl

use strict;
use warnings;
use Net::MQTT::Simple;
use JSON::MaybeXS qw(decode_json);
use POSIX qw(strftime);
use Data::Dumper;
use DateTime::Event::Sunrise;
use sigtrap qw(handler clean_exit INT TERM); # clean_exit wordt aangeroepen bij INT of TERM


# ----------------------------------------------------------------------
# 1. CONFIGURATIE & REGELPARAMETERS
# ----------------------------------------------------------------------

# MQTT Topics
my $mqtt_host     = "10.2.2.20";
my $topic_input   = "tele/energy_meter/SENSOR";          # slimme meter (JSON)
my $topic_output  = "home/canbus/amp_set";                # laadstroom instellen (A)
my $topic_off     = "home/canbus/can_off";                # voeding uit
my $topic_on      = "home/canbus/can_on";                 # voeding aan
my $topic_ac_power = "r4850g2-mqtt/sensor/01_input_ac_power/state"; # AC Power Lader (W)
my $topic_dc_power = "r4850g2-mqtt/sensor/05_output_dc_power/state"; # DC Power Lader (W)
my $topic_voltage = "r4850g2-mqtt/sensor/07_output_dc_voltage/state"; # Uitgangsspanning (V)
my $topic_inverter_power_state = "trucki/sensor/ac_output/state"; # Inverter Power current state (W) 
my $topic_inverter_set_power = "sun/commands/set_power"; # Set Inverter Power (W) 


# Regelparameters (Cruciaal voor stabiliteit)
my $TARGET_HOUSE_POWER = 0;   # Doel: Huisverbruik rond 0W
my $DEADBAND_WATT      = 50;  # Marge (dode zone): +/- 50W. Binnen deze zone geen wijziging.
my $KP_FACTOR          = 0.01; # Proportionele factor: 100W afwijking geeft 1A verandering.
my $MAX_STEP_AMP       = 2;   # Maximale wijziging per regelcyclus (voorkomt overshoot).
my $MAX_AMP            = 35;  # Maximale stroom lader (aanpassen indien nodig).
my $MIN_AMP_SET        = 1;   # Minimale instelbare stroom (wanneer lader aan staat).
my $cutoff_voltage     = 57.0; # accuspanning waarbij het laden moet stoppen
my $lat  = 51.7073;   # breedtegraad
my $long = 6.07519;    # lengtegraad


# Globale status variabelen
my $current_house_power = 0; # Power_curr (W). Positief = verbruik, Negatief = teruglevering
my $charger_ac_power    = 0; # AC Power input lader (W)
my $charger_dc_power    = 0; # DC Power output lader (W)
my $charger_voltage     = 0; # DC Uitgangsspanning lader (V)
my $inv_power           = 0; # Inverter Power current state (W)
my $last_amp_set        = $MIN_AMP_SET; # Laatst ingestelde laadstroom (A)
my $shutdown_flag = 0;

# ----------------------------------------------------------------------
# 2. HULPFUNCTIES
# ----------------------------------------------------------------------

# Subroutine voor de nette afsluiting
sub clean_exit {
    my ($mqtt) = @_;
    my $signame = shift;
    warn "Signaal $signame ontvangen. Start nette afsluiting...\n";
    $shutdown_flag = 1;
    turn_off_charger($mqtt); 
    $mqtt->publish($topic_output => 1 );
    exit(0); 
}

sub log_status {
    my ($message, $data) = @_;
    my $timestamp = strftime "%Y-%m-%d %H:%M:%S", localtime;
    print "[$timestamp] $message\n";
    if (defined $data) {
        print "[$timestamp] DEBUG DATA: " . Dumper($data);
    }
}

sub turn_off_charger {
    my ($mqtt) = @_;
    log_status("Schakel lader UIT ($topic_off) en zet laadstroom op $MIN_AMP_SET (A).");
    $mqtt->publish($topic_off => '1'); # De juiste 'uit' waarde
    $mqtt->publish($topic_output => $MIN_AMP_SET);
    $last_amp_set = $MIN_AMP_SET;
}

sub turn_on_charger {
    my ($mqtt) = @_;
    # Enkel aanzetten als de lader momenteel uit is, om dubbele publicaties te voorkomen.
    log_status("Schakel lader AAN ($topic_on).");
    $mqtt->publish($topic_on => '1'); # De juiste 'aan' waarde
}

# ----------------------------------------------------------------------
# 3. HOOFD REGELFUNCTIE
# ----------------------------------------------------------------------

sub regulate_charger {
    my ($mqtt) = @_;

    # 1. Efficiëntie berekenen (voor nauwkeurigheid)
    my $efficiency = 1.0;
    if ($charger_ac_power > 0 && $charger_dc_power > 0) {
        $efficiency = $charger_dc_power / $charger_ac_power;
        $efficiency = 1.0 if $efficiency > 1.0; # Maximaal 100%
    }
    log_status("Status: Efficiëntie = " . sprintf("%.3f", $efficiency) . " (AC: $charger_ac_power W, DC: $charger_dc_power W).");

    # 2. Bepaal de afwijking van het doel
    my $error = $current_house_power - $TARGET_HOUSE_POWER;
    log_status("Regelstatus: Huidig Huisverbruik = $current_house_power W (Afwijking: $error W).");

    # 3. Controle Marge (Deadband)
    if (abs($error) <= $DEADBAND_WATT) {
        log_status("Regelactie: Binnen de marge (+/- $DEADBAND_WATT W). Geen wijziging nodig.");
        
        # Optioneel: Lader uitschakelen als we binnen de marge zitten EN de huidige stroom minimaal is.
        if ($last_amp_set == $MIN_AMP_SET) {
            turn_off_charger($mqtt); 
        }
        return; 
    }
    
    # 4. P-Regelaar: Bepaal de benodigde stroomaanpassing (ΔA)
    # De error is positief bij verbruik (te weinig laden), negatief bij overschot (te veel laden)
    # We sturen de stroomsterkte, niet de absolute benodigde stroom (ΔA i.p.v. A)
    my $amp_adjustment = -1 * $error * $KP_FACTOR; # Negatieve error (overschot) geeft positieve aanpassing (meer laden)
    
    log_status("P-Berekening: Onbegrensde aanpassing is " . sprintf("%.2f", $amp_adjustment) . " A.");

    # 5. Staplimiet toepassen (Rate Limiting)
    if (abs($amp_adjustment) > $MAX_STEP_AMP) {
        $amp_adjustment = $MAX_STEP_AMP * ($amp_adjustment > 0 ? 1 : -1);
        log_status("Staplimiet toegepast: Wijziging beperkt tot $amp_adjustment A.");
    }
    
    # 6. Bereken nieuwe totale stroom en clamp deze
    my $new_amp_set = $last_amp_set + $amp_adjustment;
    $new_amp_set = int($new_amp_set + 0.5); # Afronden naar de dichtstbijzijnde hele Ampère

    # Clamp op minimum en maximum
    $new_amp_set = $MAX_AMP if $new_amp_set > $MAX_AMP;
    my ($sec,$min,$hour) = localtime();
	
    my $dt = DateTime->now( time_zone => 'Europe/Amsterdam' );
    my $sun = DateTime::Event::Sunrise->new(
     longitude => $long,
     latitude  => $lat,
     precise   => 1,
    );
	
    my $sunrise    = $sun->sunrise_datetime($dt);
    my $sunset     = $sun->sunset_datetime($dt);
    if ($new_amp_set <= $MIN_AMP_SET || $charger_voltage  >= $cutoff_voltage || ( $dt < $sunrise || $dt > $sunset ) ) {
	log_status("Voltage : $charger_voltage Cutoff:  $cutoff_voltage");
        # Vereist minder dan $MIN_AMP_SET -> Lader UIT
        turn_off_charger($mqtt);
        $new_amp_set = $MIN_AMP_SET; 
    } else {
        # Lader AAN en instellen
        turn_on_charger($mqtt);

        # 7. Publiceren (alleen bij daadwerkelijke wijziging)
        if ($new_amp_set != $last_amp_set) {
            log_status("Publiceer nieuwe laadstroom: $new_amp_set A naar $topic_output (was $last_amp_set A).");
            $mqtt->publish($topic_output => $new_amp_set);
            $last_amp_set = $new_amp_set;
        } else {
             log_status("Laadstroom blijft $last_amp_set A (na stap).");
        }
    }
}

# ----------------------------------------------------------------------
# 4. MQTT DEAMON LOOP
# ----------------------------------------------------------------------

# Initialiseer MQTT-client
my $mqtt = Net::MQTT::Simple->new($mqtt_host);

log_status("Verbonden met MQTT-broker op $mqtt_host. Start abonneren...");

$mqtt->last_will($topic_off => 1 );

# Abonneer op de benodigde topics
$mqtt->subscribe(
    # 1. Slimme meter data (Trigger voor de regeling)
    $topic_input => sub {
        my ($topic, $message) = @_;
        log_status("Bericht ontvangen op $topic");
        
        eval {
            my $json_data = decode_json($message);
            if (exists $json_data->{'LK13BE'} && exists $json_data->{'LK13BE'}->{'Power_curr'}) {
                $current_house_power = $json_data->{'LK13BE'}->{'Power_curr'};
                log_status("Power_curr (Huisverbruik) bijgewerkt: $current_house_power W.");
                # Voer de regeling uit na ontvangst van het belangrijkste meetpunt
                regulate_charger($mqtt);
            } else {
                log_status("Fout: Kon 'Power_curr' niet parsen uit JSON.");
                log_status("JSON ontvangen: ", \$json_data);
            }
        };
        if ($@) {
            log_status("Fout bij JSON-decodering: $@");
        }
    },

    # 2. Lader status data (voor efficiëntie berekening)
    $topic_ac_power => sub {
        my ($topic, $message) = @_;
        $charger_ac_power = $message;
    },

    $topic_dc_power => sub {
        my ($topic, $message) = @_;
        $charger_dc_power = $message;
    },

    $topic_voltage => sub {
        my ($topic, $message) = @_;
        $charger_voltage = $message +0 ;
    },

    $topic_inverter_power_state => sub {
        my ($topic, $message) = @_;
        $inv_power = $message +0 ;
    },

);

# Signaalhandlers instellen
#$SIG{INT}  = \&clean_exit($mqtt);
#$SIG{TERM} = \&clean_exit($mqtt);

# Start de hoofdloop van de daemon
log_status("Start MQTT-luisterlus (daemon)...");
$mqtt->run();

1;
