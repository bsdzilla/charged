#!/usr/bin/env perl

# ══════════════════════════════════════════════════════════════════════════════
#  heater_controller.pl
#  Stuurt een warmtestaaf aan op basis van solar-overproductie via MQTT.
#
#  Prioriteitsvolgorde:
#    1. Acculader  (r4850g2)  — heeft altijd voorrang
#    2. Warmtestaaf (r4875g1) — dit script, alleen actief als accu inactief
#    3. Teruglevering (trucki) — blokkeert ook de warmtestaaf indien actief
#
#  Vereiste modules:
#    cpanm Net::MQTT::Simple JSON::PP List::Util Time::HiRes Scalar::Util
# ══════════════════════════════════════════════════════════════════════════════

use strict;
use warnings;
use feature 'say';

use Net::MQTT::Simple;
use JSON::PP     qw(decode_json);
use List::Util   qw(min max sum);
use Time::HiRes  qw(time);
use Scalar::Util qw(looks_like_number);
use POSIX        qw(strftime);

# ── Configuratie ───────────────────────────────────────────────────────────────

my %cfg = (

    # MQTT broker
    mqtt_host              => '10.2.2.20',
    mqtt_port              => 1883,

    # Regelinterval en stapgrootte
    interval_sec           => 3,       # seconden tussen regelstappen
    step_max_amps          => 2.0,     # maximale amperewijziging per stap

    # Ampere-grenzen
    amp_min                => 3.5,     # onder dit → uitschakelen
    amp_max                => 25.0,    # nooit overschrijden

    # Hysterese voor aan/uitschakelen (in Watt)
    surplus_on_watts       => 200,     # minimaal surplus om in te schakelen
    surplus_off_watts      => 50,      # surplus waarbij wordt uitgeschakeld
                                       # (lager dan surplus_on => hysterese-kloof)

    # Smoothing (voortschrijdend gemiddelde)
    smooth_samples         => 3,       # aantal samples in het venster

    # Dode band: publiceer amp_set alleen bij wijziging groter dan dit
    amp_deadband           => 0.1,

    # ── Emergency fast-ramp ──────────────────────────────────────────────────
    # Als de ruwe (ongemiddelde) netafname deze drempel overschrijdt, wordt het
    # amperage direct in één stap teruggebracht — zonder te wachten op de
    # normale regelcyclus. Zo worden importpieken bij plotse bewolking snel
    # afgevangen. Zet op 0 om uit te schakelen.
    emergency_import_watts => 100,

    # ── Coordinatie ──────────────────────────────────────────────────────────
    # Drempel waaronder een apparaat als 'inactief' wordt beschouwd (Watt).
    # Zowel acculader als teruglevering moeten BEIDE onder deze waarde liggen
    # voordat de warmtestaaf mag inschakelen.
    coordinator_idle_watts => 20,

    # Ventilator-hysterese (graden Celsius)
    fan_full_threshold     => 35,      # boven dit → vol toeren
    fan_auto_threshold     => 33,      # onder dit → auto (2 gr kloof = hysterese)
);

# ── State ──────────────────────────────────────────────────────────────────────

my %st = (
    dc_voltage          => 58.0,   # fallback DC-spanning
    temperature         => 0.0,
    amp_set             => 0.0,    # huidig ingesteld ampere
    heater_on           => 0,      # 1 = warmtestaaf is aan
    fan_full            => 0,      # 1 = ventilator op vol toeren
    last_regulate       => 0,      # tijdstip laatste regelstap

    # Coordinatie: undef = topic nog nooit ontvangen.
    # Veilige standaard: behandel als 'actief' totdat eerste waarde binnenkomt.
    acculader_power     => undef,
    teruglevering_power => undef,
);

# Smoothing-buffers (circulaire FIFO, max smooth_samples elementen)
my @surplus_buf;    # berekend surplus in W (-Power_curr)
my @ac_power_buf;   # AC-ingangsvermogen warmtestaaf in W

# ── MQTT verbinding ────────────────────────────────────────────────────────────

my $mqtt = Net::MQTT::Simple->new("$cfg{mqtt_host}:$cfg{mqtt_port}");

$mqtt->subscribe(
    # Energiemeter
    'tele/energy_meter/SENSOR'                        => \&cb_energy_meter,

    # Warmtestaaf voeding (r4875g1)
    'r4875g1-mqtt/sensor/01_input_ac_power/state'     => \&cb_ac_power,
    'r4875g1-mqtt/sensor/05_output_dc_power/state'    => \&cb_dc_power,
    'r4875g1-mqtt/sensor/07_output_dc_voltage/state'  => \&cb_dc_voltage,
    'r4875g1-mqtt/sensor/08_output_temperature/state' => \&cb_temperature,

    # Coordinatie: acculader (prioriteit 1) en teruglevering (prioriteit 3)
    'r4850g2-mqtt/sensor/01_input_ac_power/state'     => \&cb_acculader_power,
    'trucki/sensor/ac_output/state'                   => \&cb_teruglevering_power,
);

log_info("Warmtestaaf-controller gestart  |  broker: $cfg{mqtt_host}:$cfg{mqtt_port}");
log_info("Interval: $cfg{interval_sec}s  |  Stap max: $cfg{step_max_amps}A  |  "
       . "Aan bij: $cfg{surplus_on_watts}W  |  Uit bij: $cfg{surplus_off_watts}W");
log_info("Coordinatie: wacht op eerste data van acculader en teruglevering...");

# ── Signaalafhandeling (nette afsluiting) ──────────────────────────────────────────

sub shutdown_handler {
    my ($sig) = @_;
    log_info("Signaal SIG${sig} ontvangen — warmtestaaf uitschakelen en stoppen...");
    fan_off();
    heater_off();
    log_info("Afgesloten.");
    exit 0;
}

$SIG{INT}  = \&shutdown_handler;   # Ctrl-C
$SIG{TERM} = \&shutdown_handler;   # systemctl stop / kill

# ── Hoofdlus ───────────────────────────────────────────────────────────────────

while (1) {
    $mqtt->tick(1);   # verwerk MQTT-berichten, blokkeert max. 1 seconde

    my $now = time();
    if ($now - $st{last_regulate} >= $cfg{interval_sec}) {
        regulate();
        $st{last_regulate} = $now;
    }
}

# ══════════════════════════════════════════════════════════════════════════════
# MQTT-callbacks — energiemeter en warmtestaaf
# ══════════════════════════════════════════════════════════════════════════════

sub cb_energy_meter {
    my (undef, $payload) = @_;
    my $data = eval { decode_json($payload) };
    if ($@) {
        log_warn("JSON parse fout energiemeter: $@");
        return;
    }
    my $power = $data->{LK13BE}{Power_curr};
    return unless defined $power && looks_like_number($power);

    # Negatieve Power_curr = export naar net = positief surplus
    my $surplus_raw = -$power;
    push_smooth(\@surplus_buf, $surplus_raw);

    # ── Emergency fast-ramp ──────────────────────────────────────────────────
    # Gebruik de ruwe waarde (niet het gemiddelde) voor snelle reactie.
    # Alleen actief als warmtestaaf aan is en coordinatie het toestaat.
    if (   $cfg{emergency_import_watts} > 0
        && $st{heater_on}
        && $surplus_raw < -$cfg{emergency_import_watts} )
    {
        emergency_ramp($surplus_raw);
    }
}

sub cb_ac_power {
    my (undef, $payload) = @_;
    return unless looks_like_number($payload);
    push_smooth(\@ac_power_buf, $payload + 0);
}

sub cb_dc_power {
    # DC-outputvermogen warmtestaaf — voor diagnose / toekomstig gebruik
}

sub cb_dc_voltage {
    my (undef, $payload) = @_;
    return unless looks_like_number($payload) && $payload > 10;
    $st{dc_voltage} = $payload + 0;
}

sub cb_temperature {
    my (undef, $payload) = @_;
    return unless looks_like_number($payload);
    $st{temperature} = $payload + 0;
    regulate_fan();
}

# ══════════════════════════════════════════════════════════════════════════════
# MQTT-callbacks — coordinatie
# ══════════════════════════════════════════════════════════════════════════════

sub cb_acculader_power {
    my (undef, $payload) = @_;
    return unless looks_like_number($payload);

    my $prev       = $st{acculader_power};
    my $idle       = $cfg{coordinator_idle_watts};
    $st{acculader_power} = $payload + 0;

    my $was_active = defined($prev) && $prev >= $idle;
    my $is_active  = $st{acculader_power} >= $idle;

    if (!$was_active && $is_active) {
        log_info(sprintf "Acculader ACTIEF (%.0fW >= %dW) — warmtestaaf geblokkeerd",
            $st{acculader_power}, $idle);
        if ($st{heater_on}) {
            log_info("Acculader gestart terwijl warmtestaaf aan was → direct UIT (prioriteit 1)");
            heater_off();
        }
    }
    elsif ($was_active && !$is_active) {
        log_info(sprintf "Acculader INACTIEF (%.0fW < %dW) — blokkade opgeheven",
            $st{acculader_power}, $idle);
    }
}

sub cb_teruglevering_power {
    my (undef, $payload) = @_;
    return unless looks_like_number($payload);

    my $prev       = $st{teruglevering_power};
    my $idle       = $cfg{coordinator_idle_watts};
    $st{teruglevering_power} = $payload + 0;

    my $was_active = defined($prev) && $prev >= $idle;
    my $is_active  = $st{teruglevering_power} >= $idle;

    if (!$was_active && $is_active) {
        log_info(sprintf "Teruglevering ACTIEF (%.0fW >= %dW) — warmtestaaf geblokkeerd",
            $st{teruglevering_power}, $idle);
        if ($st{heater_on}) {
            log_info("Teruglevering gestart terwijl warmtestaaf aan was → direct UIT");
            heater_off();
        }
    }
    elsif ($was_active && !$is_active) {
        log_info(sprintf "Teruglevering INACTIEF (%.0fW < %dW) — blokkade opgeheven",
            $st{teruglevering_power}, $idle);
    }
}

# ══════════════════════════════════════════════════════════════════════════════
# Coordinatie-check
# ══════════════════════════════════════════════════════════════════════════════

# Geeft 1 terug als de warmtestaaf mag draaien, anders 0.
# Zolang een topic nog nooit ontvangen is (undef) geldt dat apparaat als
# 'mogelijk actief' — veilige standaard, voorkomt conflict bij opstart.
sub coordinator_allows {
    my $idle = $cfg{coordinator_idle_watts};

    unless (defined $st{acculader_power}) {
        log_info("Coordinatie: wacht nog op eerste acculader-meting") if !$st{heater_on};
        return 0;
    }
    if ($st{acculader_power} >= $idle) {
        return 0;
    }

    unless (defined $st{teruglevering_power}) {
        log_info("Coordinatie: wacht nog op eerste teruglevering-meting") if !$st{heater_on};
        return 0;
    }
    if ($st{teruglevering_power} >= $idle) {
        return 0;
    }

    return 1;
}

# ══════════════════════════════════════════════════════════════════════════════
# Regellogica
# ══════════════════════════════════════════════════════════════════════════════

# ══════════════════════════════════════════════════════════════════════════════
# Emergency fast-ramp
# ══════════════════════════════════════════════════════════════════════════════

# Wordt aangeroepen vanuit cb_energy_meter bij een ruwe importpiek.
# Berekent direct het gewenste ampere op basis van het actuele AC-verbruik
# van de staaf min het import-overschot, en publiceert dat onmiddellijk.
# De normale regelcyclus loopt daarna gewoon door en verfijnt verder.
sub emergency_ramp {
    my ($surplus_raw) = @_;   # negatief = we importeren

    my $ac_power = avg(\@ac_power_buf) // 0;
    my $voltage  = $st{dc_voltage};

    # Doelvermogen = huidig AC-verbruik + surplus_raw (surplus_raw is negatief)
    # We trekken het import-overschot direct van het verbruik af.
    my $target_watts = $ac_power + $surplus_raw;
    my $target_amps  = clamp($target_watts / $voltage, $cfg{amp_min}, $cfg{amp_max});
    my $amp_int      = int($target_amps);

    log_info(sprintf
        "EMERGENCY ramp: import=%.0fW  ac=%.0fW  target=%.0fW  amp: %.1fA -> %dA",
        -$surplus_raw, $ac_power, $target_watts, $st{amp_set}, $amp_int
    );

    $st{amp_set} = $target_amps;
    $mqtt->publish('home/canbus75/amp_set', $amp_int);

    # Reset de smoothing-buffer zodat de normale regelaar aansluit op de
    # nieuwe toestand en niet probeert terug te regelen naar het oude gemiddelde.
    @surplus_buf = ($surplus_raw);
}

sub regulate {
    my $surplus  = avg(\@surplus_buf)  // 0;
    my $ac_power = avg(\@ac_power_buf) // 0;
    my $voltage  = $st{dc_voltage};
    my $allowed  = coordinator_allows();

    log_info(sprintf
        "surplus=%+.0fW  ac=%.0fW  volt=%.1fV  amp=%.1fA  aan=%s  "
      . "temp=%.1f°C  accu=%.0fW  terug=%.0fW  toegestaan=%s",
        $surplus, $ac_power, $voltage, $st{amp_set},
        ($st{heater_on} ? 'JA' : 'NEE'),
        $st{temperature},
        $st{acculader_power}     // -1,
        $st{teruglevering_power} // -1,
        ($allowed ? 'JA' : 'NEE')
    );

    # ── Coordinatie-blokkade ───────────────────────────────────────────────────
    unless ($allowed) {
        if ($st{heater_on}) {
            log_info("Coordinatie: blokkade actief → warmtestaaf UIT");
            heater_off();
	    fan_off();
        }
        return;
    }

    # ── Inschakelen (met hysterese) ────────────────────────────────────────────
    unless ($st{heater_on}) {
        if ($surplus >= $cfg{surplus_on_watts}) {
            log_info("Surplus ${surplus}W >= $cfg{surplus_on_watts}W en coordinatie OK → AAN");
            heater_on();
        }
        return;
    }

    # ── Proportionele regelstap (P-regelaar met stapbeperking) ─────────────────
    #
    # surplus > 0  =>  we exporteren nog, meer vermogen kan er bij
    # surplus < 0  =>  we importeren, vermogen moet omlaag
    # Deling door spanning geeft de benodigde ampere-wijziging.
    # step_max_amps begrenst de maximale wijziging per stap (anti-oscillatie).

    my $delta_amps = clamp(
        $surplus / $voltage,
        -$cfg{step_max_amps},
         $cfg{step_max_amps}
    );

    my $new_amp = clamp(
        $st{amp_set} + $delta_amps,
        $cfg{amp_min},
        $cfg{amp_max}
    );

    # ── Uitschakelen (met hysterese) ───────────────────────────────────────────
    # Schakel uit als we op minimum zitten en het surplus te laag is.
    # surplus_off_watts < surplus_on_watts zorgt voor de hysterese-kloof.
    if ($st{amp_set} <= $cfg{amp_min} && $surplus <= $cfg{surplus_off_watts}) {
        log_info(sprintf "Op minimum %.1fA en surplus %.0fW <= %dW → UIT",
            $cfg{amp_min}, $surplus, $cfg{surplus_off_watts});
        heater_off();
        return;
    }

    # ── Nieuw setpoint publiceren (alleen bij betekenisvolle wijziging) ─────────
    if (abs($new_amp - $st{amp_set}) >= $cfg{amp_deadband}) {
        $st{amp_set} = $new_amp;
        my $amp_int = int($new_amp);   # voeding accepteert alleen integers; naar beneden afronden
        log_info(sprintf "amp_set -> %dA  (intern %.2fA, delta %+.2fA)", $amp_int, $new_amp, $delta_amps);
        $mqtt->publish('home/canbus75/amp_set', $amp_int);
    }
}

# ── Warmtestaaf aan/uit ───────────────────────────────────────────────────────

sub heater_on {
    $st{heater_on} = 1;
    $st{amp_set}   = $cfg{amp_min};

    # Zet eerst het ampere, dan inschakelen (veilig opstarten)
    my $amp_int = int($cfg{amp_min});
    $mqtt->publish('home/canbus75/amp_set', $amp_int);
    $mqtt->publish('home/canbus75/can_on', '1');
    log_info("-> MQTT: amp_set=${amp_int}A, can_on=1");
}

sub heater_off {
    $st{heater_on} = 0;
    $st{amp_set}   = 0.0;

    $mqtt->publish('home/canbus75/can_off', '1');
    log_info("-> MQTT: can_off=1");
}

# ══════════════════════════════════════════════════════════════════════════════
# Ventilatorregeling
# ══════════════════════════════════════════════════════════════════════════════

sub regulate_fan {
    my $temp = $st{temperature};

    if (!$st{fan_full} && $temp > $cfg{fan_full_threshold}) {
        log_info(sprintf "Temp %.1f gr > %d gr → Ventilator VOL TOEREN",
            $temp, $cfg{fan_full_threshold});
        $mqtt->publish('home/canbus75/16_fan_full_speed_button/command', 'PRESS');
        $st{fan_full} = 1;
    }
    elsif ($st{fan_full} && $temp < $cfg{fan_auto_threshold}) {
        log_info(sprintf "Temp %.1f gr < %d gr → Ventilator AUTO",
            $temp, $cfg{fan_auto_threshold});
	fan_auto();
        $st{fan_full} = 0;
    }
}

sub fan_auto {
        $mqtt->publish('r4875g1-mqtt/button/17_fan_auto_mode_button/command', 'PRESS');
}
# ══════════════════════════════════════════════════════════════════════════════
# Hulpfuncties
# ══════════════════════════════════════════════════════════════════════════════

sub push_smooth {
    my ($buf, $val) = @_;
    push @$buf, $val;
    shift @$buf if @$buf > $cfg{smooth_samples};
}

sub avg {
    my ($buf) = @_;
    return undef unless @$buf;
    return sum(@$buf) / scalar(@$buf);
}

sub clamp {
    my ($val, $lo, $hi) = @_;
    return max($lo, min($hi, $val));
}

sub log_info {
    my ($msg) = @_;
    printf "[%s] INFO  %s\n", _ts(), $msg;
}

sub log_warn {
    my ($msg) = @_;
    printf "[%s] WARN  %s\n", _ts(), $msg;
}

sub _ts { strftime("%Y-%m-%d %H:%M:%S", localtime) }

__END__

=head1 NAME

heater_controller.pl - MQTT-gestuurde warmtestaaf op basis van solar-overproductie

=head1 SYNOPSIS

    perl heater_controller.pl

=head1 BESCHRIJVING

Leest de netto netstroom via MQTT en stuurt een warmtestaaf aan met de
beschikbare overproductie van een solar-installatie.

Prioriteitsvolgorde:
  1. Acculader (r4850g2)    - heeft altijd voorrang; blokkeert warmtestaaf
  2. Warmtestaaf (r4875g1)  - dit script (prioriteit 2)
  3. Teruglevering (trucki) - blokkeert ook warmtestaaf indien actief

Regeling:
  - Power_curr < 0          => overproductie beschikbaar
  - P-regelaar met stapbeperking en voortschrijdend gemiddelde
  - Hysterese aan/uit: apart in- en uitschakeldrempel
  - Minimumampere: onder 4A wordt de staaf uitgeschakeld
  - Ventilatorregeling met 2 grC hysterese-kloof
  - Veilige opstart: geblokkeerd totdat eerste data van beide coordinatietopics
    ontvangen is

=head1 VEREISTE MODULES

    cpanm Net::MQTT::Simple JSON::PP List::Util Time::HiRes Scalar::Util

=head1 CONFIGURATIE

Pas het C<%cfg>-hash bovenaan het script aan.

=cut

